<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SyKaşif</title>
    <link rel="stylesheet" href="/syk-ui/css/app.css">
    <link rel="stylesheet" href="/syk-ui/css/module_views.css">
    <link rel="stylesheet" href="/syk-ui/css/scientific_views.css">
    <link rel="stylesheet" href="/syk-ui/css/device_hub.css">
<link
    rel="stylesheet"
    href="/syk-ui/css/dtse_attention_overlay.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/dtse_evidence_card.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/dtse_evidence_focus.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/dtse_evidence_scientific_runtime.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/media_upload_panel.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/adaptive_environment.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/theme_runtime.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/mobile_device_runtime.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/mobile_sensor_runtime.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/mobile_offline_runtime.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/mobile_control_panel.css"
>
<link
    rel="stylesheet"
    href="/syk-ui/css/kasif_icon_runtime.css"
>
    <link rel="stylesheet" href="/syk-ui/css/map_workspace_view.css">
    <link rel="stylesheet" href="/syk-ui/css/sonar_session_panel.css">

<!-- SYK_MOBILE_POINTER_FIX_BASLANGIC -->
<style>
#syk-mobile-control-panel {
    pointer-events: none !important;
    width: auto !important;
    height: auto !important;
    inset: auto 12px 12px auto !important;
}

#syk-mobile-control-toggle {
    pointer-events: auto !important;
    position: fixed !important;
    right: 12px !important;
    bottom: 12px !important;
    left: auto !important;
    top: auto !important;
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    min-height: 48px !important;
    max-width: 48px !important;
    max-height: 48px !important;
    overflow: hidden !important;
    z-index: 1000 !important;
}

#syk-mobile-control-panel [aria-hidden="false"],
#syk-mobile-control-panel.is-open,
#syk-mobile-control-panel[data-open="true"] {
    pointer-events: auto !important;
}
</style>
<!-- SYK_MOBILE_POINTER_FIX_BITIS -->

</head>
<body>
    <main id="syk-app" class="syk-app">
        <header class="syk-header">
            <section class="brand-area">
                <div id="brand-title" class="syk-brand">SyKaşif</div>
                <div id="system-state" class="syk-system-state">
                    Sistem hazırlanıyor
                </div>
            </section>

            <section class="top-status">
                <div class="status-item">
                    <span>Bağlantı</span>
                    <strong id="connection-state">Bekleniyor</strong>
                </div>

                <div class="status-item">
                    <span>Tema</span>
                    <strong id="theme-state">—</strong>
                </div>

                <div class="status-item">
                    <span>Hava</span>
                    <strong id="weather-state">—</strong>
                </div>

                <button id="sound-toggle" type="button">
                    Ses Kapalı
                </button>
            </section>
        </header>

        <section class="syk-layout">
            <nav class="left-panel">
                <div class="panel-title">MODÜLLER</div>
                <div id="module-list" class="syk-modules"></div>
            </nav>

            <section class="syk-workspace">
                <div class="workspace-header">
                    <div id="active-module" class="syk-active-module">
                        Ana Terminal
                    </div>

                    <div id="runtime-clock" class="runtime-clock">--:--:--</div>
                </div>

                <div id="module-view" class="module-view" hidden></div>

                <div id="map-stage" class="map-stage">
                    <div class="grid-lines"></div>

                    <div class="map-marker marker-one"></div>
                    <div class="map-marker marker-two"></div>
                    <div class="map-marker marker-three"></div>

                    <div class="map-center">
                        <span class="pulse-ring ring-one"></span>
                        <span class="pulse-ring ring-two"></span>
                        <span class="pulse-ring ring-three"></span>
                        <span class="map-core"></span>
                    </div>
                </div>

                <div id="syframe" class="syframe" data-state="analyzing">
                    <span class="corner top-left"></span>
                    <span class="corner top-right"></span>
                    <span class="corner bottom-left"></span>
                    <span class="corner bottom-right"></span>

                    <div class="syframe-content">
                        <strong id="syframe-title">
                            Analiz Ediliyor
                        </strong>

                        <span id="syframe-confidence">
                            Güven: %0
                        </span>
                    </div>
                </div>

                <footer class="evidence-strip">
                    <article class="evidence-card">
                        <span>GÖRÜNTÜ</span>
                        <strong>Hazır</strong>
                    </article>

                    <article class="evidence-card">
                        <span>SES</span>
                        <strong id="audio-state">Hazır</strong>
                    </article>

                    <article class="evidence-card">
                        <span>HARİTA</span>
                        <strong>Aktif</strong>
                    </article>

                    <article class="evidence-card">
                        <span>KANIT</span>
                        <strong>Bekleniyor</strong>
                    </article>
                </footer>
            </section>

            <aside class="right-panel">
                <div class="panel-title">CANLI DURUM</div>

                <section class="detail-card">
                    <span>Aktif Modül</span>
                    <strong id="detail-module">Ana Terminal</strong>
                </section>

                <section class="detail-card">
                    <span>SyFrame Durumu</span>
                    <strong id="detail-frame">Analiz Ediliyor</strong>
                </section>

                <section class="detail-card">
                    <span>Güven</span>
                    <strong id="detail-confidence">%0</strong>
                </section>

                <section class="detail-card">
                    <span>Mevsim</span>
                    <strong id="detail-season">—</strong>
                </section>

                <section class="detail-card">
                    <span>Rüzgâr</span>
                    <strong id="detail-wind">0</strong>
                </section>

                <section class="event-panel">
                    <div class="panel-title">OLAY AKIŞI</div>
                    <div id="event-stream" class="event-stream"></div>
                </section>
            </aside>
        </section>

        <audio id="runtime-audio" preload="auto"></audio>
    


<!-- SYK_BILIMSEL_MODUL_PANELI_BASLANGIC -->
<style>
#syk-bilimsel-modul-paneli {
    position: relative !important;
    z-index: 2147483000 !important;
    pointer-events: auto !important;
}

#syk-bilimsel-modul-paneli button {
    position: relative !important;
    z-index: 2147483001 !important;
    pointer-events: auto !important;
}

#syk-mobile-control-panel,
#syk-media-upload-panel {
    pointer-events: none !important;
}

#syk-mobile-control-panel button,
#syk-media-upload-panel button,
#syk-media-upload-panel input,
#syk-media-upload-panel label {
    pointer-events: auto !important;
}
</style>

<section
    id="syk-bilimsel-modul-paneli"
    aria-label="Bilimsel Mod?ller"
>
    <h2>Bilimsel Mod?ller</h2>

    <div class="syk-bilimsel-modul-grid">
        <button type="button" data-screen-title="JEOLOJ?">Jeoloji</button>
        <button type="button" data-screen-title="FREKANS">Frekans</button>
        <button type="button" data-screen-title="LiDAR" data-runtime-state="donanim_bekliyor">LiDAR</button>
        <button type="button" data-screen-title="ASTRONOM? / ARKEOASTRONOM?">Astronomi</button>
        <button type="button" data-screen-title="K?MYASAL ANAL?Z">Kimyasal Analiz</button>
        <button type="button" data-screen-title="SPEKTRAL ANAL?Z" data-runtime-state="donanim_bekliyor">Spektral Analiz</button>
        <button type="button" data-screen-title="TERMAL ANAL?Z" data-runtime-state="donanim_bekliyor">Termal Analiz</button>
        <button type="button" data-screen-title="MANYETOMETRE" data-runtime-state="donanim_bekliyor">Manyetometre</button>
        <button type="button" data-screen-title="GRAV?METRE" data-runtime-state="donanim_bekliyor">Gravimetre</button>
        <button type="button" data-screen-title="ELEKTR?K D?REN? ? ERT" data-runtime-state="donanim_bekliyor">Elektrik Diren?</button>
        <button type="button" data-screen-title="GPR ? YER RADARI" data-runtime-state="donanim_bekliyor">GPR</button>
        <button type="button" data-screen-title="S?SM?K" data-runtime-state="donanim_bekliyor">Sismik</button>
        <button type="button" data-screen-title="H?DROJEOLOJ?">Hidrojeoloji</button>
        <button type="button" data-screen-title="BOTAN?K">Botanik</button>
        <button type="button" data-screen-title="TOPRAK ANAL?Z?">Toprak</button>
        <button type="button" data-screen-title="SU ANAL?Z?">Su</button>
    </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const moduleView = document.getElementById("module-view");

    document
        .querySelectorAll(
            "#syk-bilimsel-modul-paneli button[data-screen-title]"
        )
        .forEach(function (button) {
            button.addEventListener("click", function () {
                if (!moduleView) {
                    throw new Error("module-view bulunamad?");
                }

                const title = button.dataset.screenTitle;
                const waiting =
                    button.dataset.runtimeState ===
                    "donanim_bekliyor";

                moduleView.hidden = false;
                moduleView.removeAttribute("hidden");
                moduleView.setAttribute("aria-hidden", "false");

                moduleView.innerHTML = `
                    <section class="scientific-view">
                        <header class="scientific-title">
                            <span>Bilimsel Mod?l</span>
                            <strong>${title}</strong>
                        </header>

                        <div class="scientific-grid">
                            <article class="scientific-card">
                                <h2>Durum</h2>
                                <strong class="scientific-status">
                                    ${waiting ? "Donan?m bekleniyor" : "Haz?r"}
                                </strong>
                            </article>

                            <article class="scientific-card">
                                <h2>Veri Ak???</h2>
                                <strong>
                                    ${waiting ? "Ba?lant? bekleniyor" : "Kullan?ma haz?r"}
                                </strong>
                            </article>

                            <article class="scientific-card">
                                <h2>Do?rulama</h2>
                                <strong>Mod?l kay?tl?</strong>
                            </article>
                        </div>
                    </section>
                `;
            });
        });
});
</script>
<!-- SYK_BILIMSEL_MODUL_PANELI_BITIS -->



</main>

    <script src="/syk-ui/js/scientific_views.js" defer></script>
    <script src="/syk-ui/js/scientific_api_views.js" defer></script>
    <script src="/syk-ui/js/device_hub.js" defer></script>
    <script src="/syk-ui/js/module_views.js" defer></script>
    <script src="/syk-ui/js/app.js" defer></script>
<script
    src="/syk-ui/js/dtse_attention_overlay.js"
></script>
<script
    src="/syk-ui/js/dtse_evidence_card.js"
></script>
<script
    src="/syk-ui/js/dtse_evidence_focus.js"
></script>
<script
    src="/syk-ui/js/dtse_evidence_scientific_runtime.js"
></script>
<script
    src="/syk-ui/js/media_upload_panel.js"
></script>
<script
    src="/syk-ui/js/adaptive_environment.js"
></script>
<script
    src="/syk-ui/js/theme_runtime.js"
></script>
<script
    src="/syk-ui/js/jarmin_integration.js"
></script>
<script
    src="/syk-ui/js/mobile_device_runtime.js"
></script>
<script
    src="/syk-ui/js/mobile_sensor_runtime.js"
></script>
<script
    src="/syk-ui/js/mobile_offline_runtime.js"
></script>
<script
    src="/syk-ui/js/mobile_control_panel.js"
></script>
<script
    src="/syk-ui/js/kasif_icon_runtime.js"
></script>

<script>
(() => {
    "use strict";

    const duzelt = () => {
        const dugmeler = document.querySelectorAll(
            "#module-list button.syk-module-button"
        );

        for (const dugme of dugmeler) {
            if (
                dugme.textContent.trim()
                === "GPS"
            ) {
                dugme.setAttribute(
                    "aria-label",
                    "Konum bölümü"
                );
            }
        }
    };

    document.addEventListener(
        "DOMContentLoaded",
        duzelt,
        {
            once: true,
        }
    );

    const gozlemci = new MutationObserver(
        duzelt
    );

    gozlemci.observe(
        document.documentElement,
        {
            childList: true,
            subtree: true,
        }
    );

    window.setTimeout(
        () => {
            duzelt();
            gozlemci.disconnect();
        },
        5000
    );
})();
// SYK_GPS_ERISILEBILIR_AD_DUZELTMESI
</script>

    <script src="/syk-ui/js/scientific_visibility_guard.js"></script>
    <script src="/syk-ui/js/map_workspace_view.js"></script>
    <script src="/syk-ui/js/sonar_session_panel.js"></script>
</body>
</html>